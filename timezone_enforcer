#!/bin/bash

AGENT_NAME="com.timezone.enforcer"
USERNAME=$(whoami)
SCRIPT_PATH="/Users/$USERNAME/timezone_enforcer.sh"
PLIST_PATH="/Users/$USERNAME/Library/LaunchAgents/${AGENT_NAME}.plist"
SUDOERS_FILE="/private/etc/sudoers.d/timezone_enforcer"

create_helper_script() {
    echo "[*] Creating helper script at $SCRIPT_PATH..."

    cat <<'EOF' > "$SCRIPT_PATH"
#!/bin/bash

DESIRED_TZ="America/New_York"
CURRENT_TZ=$(/usr/sbin/systemsetup -gettimezone | awk '{print $3}')

# Check time offset using ntpdate
OFFSET=$(/usr/sbin/ntpdate -q time.apple.com 2>/dev/null | grep offset | awk '{print $10}')
OFFSET_CLEAN=$(echo "$OFFSET" | awk '{printf("%.0f", $1 * 1000)}')
ABS_OFFSET=$(echo ${OFFSET_CLEAN#-})

# Define threshold in milliseconds (60000ms = 60 seconds)
THRESHOLD=60000

if [[ "$CURRENT_TZ" != "$DESIRED_TZ" || $ABS_OFFSET -gt $THRESHOLD ]]; then
    echo "[*] Timezone mismatch or clock skew detected. Fixing..."
    sudo /usr/sbin/systemsetup -setusingnetworktime off
    sudo /usr/sbin/systemsetup -settimezone "$DESIRED_TZ"
    sudo /usr/sbin/sntp -sS time.apple.com
    sudo /usr/sbin/systemsetup -setusingnetworktime on
    sudo killall -HUP timed
    sudo killall SystemUIServer
    echo "[✓] Timezone corrected."
fi
EOF

    chmod +x "$SCRIPT_PATH"
}

create_launch_agent() {
    echo "[*] Creating LaunchAgent at $PLIST_PATH..."

    cat <<EOF > "$PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${AGENT_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${SCRIPT_PATH}</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer> <!-- every 10 minutes -->
    <key>RunAtLoad</key>
    <true/> <!-- run immediately on login -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
EOF
}

add_sudoers_rule() {
    if [ ! -f "$SUDOERS_FILE" ]; then
        echo "[*] Adding passwordless sudoers rule..."
        SUDOERS_LINE="$USERNAME ALL=(ALL) NOPASSWD: /usr/sbin/systemsetup, /usr/sbin/sntp, /usr/bin/killall"
        echo "$SUDOERS_LINE" | sudo tee "$SUDOERS_FILE" >/dev/null
        sudo chmod 440 "$SUDOERS_FILE"
        echo "[✓] Sudoers rule added."
    else
        echo "[i] Sudoers rule already exists. Skipping."
    fi
}

remove_sudoers_rule() {
    if [ -f "$SUDOERS_FILE" ]; then
        echo "[*] Removing sudoers rule..."
        sudo rm -f "$SUDOERS_FILE"
        echo "[✓] Sudoers rule removed."
    else
        echo "[i] No sudoers rule to remove."
    fi
}

start_enforcement() {
    add_sudoers_rule
    create_helper_script
    create_launch_agent

    echo "[*] Loading LaunchAgent..."
    launchctl unload "$PLIST_PATH" 2>/dev/null
    launchctl load "$PLIST_PATH"

    echo "[*] Executing the helper script immediately..."
    "$SCRIPT_PATH"

    echo "[✓] Timezone enforcement started."
}

stop_enforcement() {
    echo "[*] Unloading LaunchAgent..."
    launchctl unload "$PLIST_PATH" 2>/dev/null

    echo "[*] Removing helper script and LaunchAgent plist..."
    rm -f "$SCRIPT_PATH" "$PLIST_PATH"

    remove_sudoers_rule

    echo "[✓] Timezone enforcement stopped and cleaned up."
}

case "$1" in
    start)
        start_enforcement
        ;;
    stop)
        stop_enforcement
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        ;;
esac
