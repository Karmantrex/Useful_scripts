#!/usr/bin/env bash

# One time setup
# bash /path/to/autobluetooth_control.sh install

# To start
# autobluetooth_control.sh start

# To see status
# autobluetooth_control.sh status

# To stop
# autobluetooth_control.sh stop


# ————————————————
# autobluetooth_control.sh
# A) install prerequisites & copy to ~/bin
# B) start/stop/status/run your 10-min auto-connect job
# ————————————————

# ————————————————
# Configuration
# ————————————————
LAUNCH_LABEL="com.autobluetooth.autoconnect"
PLIST_PATH="$HOME/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
CONFIG_FILE="$HOME/.autobluetooth_autoconnect_device"
SCRIPT_NAME="autobluetooth_control.sh"
TARGET_PATH="$HOME/bin/$SCRIPT_NAME"

# Detect shell rc file for PATH edits
detect_rc() {
  case "${SHELL##*/}" in
    zsh)  echo "$HOME/.zshrc";  ;;
    bash) echo "$HOME/.bash_profile"; ;;
    *)    echo "$HOME/.profile"; ;;
  esac
}

# ————————————————
# Helpers
# ————————————————

install_prereqs() {
  # 1) Homebrew
  if ! command -v brew &>/dev/null; then
    echo "🍺 Installing Homebrew…"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  # 2) blueutil
  if ! command -v blueutil &>/dev/null; then
    echo "🔧 Installing blueutil…"
    brew install blueutil
  fi

  # 3) ~/bin & copy self
  echo "📂 Ensuring ~/bin exists…"
  mkdir -p "$HOME/bin"
  echo "📋 Copying script to ~/bin/$SCRIPT_NAME…"
  cp "$BASH_SOURCE" "$TARGET_PATH"
  chmod +x "$TARGET_PATH"

  # 4) PATH in shell rc
  RC_FILE="$(detect_rc)"
  if ! grep -qx 'export PATH="$HOME/bin:$PATH"' "$RC_FILE" 2>/dev/null; then
    echo 'export PATH="$HOME/bin:$PATH"' >> "$RC_FILE"
    echo "🔁 Added ~/bin to PATH in $RC_FILE"
  fi

  echo
  echo "✅ Installation complete!"
  echo "- Restart your shell or run: source $RC_FILE"
  echo "- Then you can use: $SCRIPT_NAME {install|start|status|stop}"
}

list_and_choose() {
  echo "🔍 Fetching paired Bluetooth devices..."
  mapfile -t DEVICES < <(blueutil --paired)
  [[ ${#DEVICES[@]} -gt 0 ]] || { echo "⚠️ No paired devices found."; exit 1; }

  echo; printf "Choose a device to auto-connect:\n\n"
  for i in "${!DEVICES[@]}"; do
    mac="${DEVICES[$i]%% *}"
    name="${DEVICES[$i]#* }"
    printf "  [%d] %s (%s)\n" $((i+1)) "$name" "$mac"
  done
  echo; read -rp "Enter number: " sel

  if ! [[ "$sel" =~ ^[1-9][0-9]*$ ]] || (( sel > ${#DEVICES[@]} )); then
    echo "🚫 Invalid selection."; exit 1
  fi

  choice="${DEVICES[$((sel-1))]}"
  echo "${choice%% *}" >| "$CONFIG_FILE"
  echo "✅ Saved ‘${choice#* }’ for auto-connect."
}

install_launch_agent() {
  cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LAUNCH_LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$TARGET_PATH</string><string>run</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:$HOME/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/autobluetooth.out</string>
  <key>StandardErrorPath</key><string>/tmp/autobluetooth.err</string>
</dict></plist>
EOF

  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl load   "$PLIST_PATH"
  echo "🚀 Auto-connect scheduled every 10 minutes."
}

uninstall_launch_agent() {
  launchctl unload "$PLIST_PATH" 2>/dev/null && echo "🛑 Unloaded LaunchAgent."
  rm -f "$PLIST_PATH" "$CONFIG_FILE"
  echo "🗑️  Cleaned up config & plist."
}

run_connect() {
  [[ -f "$CONFIG_FILE" ]] || { echo "⚠️  No device set—run ‘start’ first."; exit 1; }
  mac="$(<"$CONFIG_FILE")"
  if [[ "$(blueutil --is-connected "$mac")" -eq 0 ]]; then
    echo "🔗 Connecting to $mac…"
    blueutil --connect "$mac"
  else
    echo "✅ Already connected to $mac."
  fi
}

# ————————————————
# Main
# ————————————————
case "$1" in
  install)
    install_prereqs
    ;;

  start)
    list_and_choose
    install_launch_agent
    ;;

  stop)
    uninstall_launch_agent
    ;;

  status)
    if launchctl list | grep -q "$LAUNCH_LABEL"; then
      echo "✅ Auto-connect is running."
    else
      echo "⚠️ Auto-connect is not running."
    fi
    ;;

  run)
    run_connect
    ;;

  *)
    cat <<USAGE

Usage: $SCRIPT_NAME {install|start|stop|status|run}

  install → one-shot setup: brew, blueutil, copy & chmod, PATH
  start   → select device & schedule every-10-min job
  stop    → cancel job + wipe config
  status  → show if auto-connect is active
  run     → internal; you don’t normally call this

USAGE
    exit 1
    ;;
esac
