install_prereqs() {
  # Detect where this script is located, even if it's been symlinked
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  # 1) Homebrew
  if ! command -v brew &>/dev/null; then
    echo "🍺 Installing Homebrew…"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  # 2) blueutil
  if ! command -v blueutil &>/dev/null; then
    echo "🔧 Installing blueutil…"
    brew install blueutil
  fi

  # 3) Copy the script into a fixed location if you want
  #    (optional—skip this if you want to run it in-place)
  mkdir -p "$HOME/bin"
  cp "$BASH_SOURCE" "$HOME/bin/$SCRIPT_NAME"
  chmod +x "$HOME/bin/$SCRIPT_NAME"

  # 4) Append the script’s directory (SCRIPT_DIR) to your PATH
  RC_FILE="$(detect_rc)"
  export_line="export PATH=\"$SCRIPT_DIR:\$PATH\""
  if ! grep -qxF "$export_line" "$RC_FILE" 2>/dev/null; then
    echo "$export_line" >> "$RC_FILE"
    echo "🔁 Added $SCRIPT_DIR to PATH in $RC_FILE"
  else
    echo "ℹ️  PATH entry already present in $RC_FILE"
  fi

  # 5) If user sourced this script, immediately reload their RC
  if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    source "$RC_FILE"
    echo "🔄 Sourced $RC_FILE—PATH is up to date."
  else
    echo "🚀 Restart your shell (or run: source $RC_FILE) to get the updated PATH."
  fi

  echo
  echo "✅ Installation complete! Now you can run:"
  echo "   $SCRIPT_NAME {start|status|stop}"
}
