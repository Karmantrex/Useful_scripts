#!/usr/bin/env bash

# ————————————————
# Configuration
# ————————————————
LAUNCH_LABEL="com.autobluetooth.autoconnect"
PLIST_PATH="$HOME/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
CONFIG_FILE="$HOME/.autobluetooth_autoconnect_device"

# Find blueutil
BLUEUTIL="$(which blueutil)"
if [[ -z "$BLUEUTIL" ]]; then
  echo "❌  blueutil not found. Install with: brew install blueutil"
  exit 1
fi

# ————————————————
# Helpers
# ————————————————
list_and_choose() {
  echo "🔍 Fetching paired Bluetooth devices..."
  mapfile -t DEVICES < <("$BLUEUTIL" --paired)
  if [[ ${#DEVICES[@]} -eq 0 ]]; then
    echo "⚠️ No paired devices found."
    exit 1
  fi

  echo
  printf "Choose a device to auto-connect:\n\n"
  for i in "${!DEVICES[@]}"; do
    line="${DEVICES[$i]}"
    # assume first token is MAC, rest is name
    mac="${line%% *}"
    name="${line#* }"
    printf "  [%d] %s (%s)\n" $((i+1)) "$name" "$mac"
  done
  echo

  read -rp "Enter number: " sel
  if ! [[ "$sel" =~ ^[0-9]+$ ]] \
     || (( sel < 1 || sel > ${#DEVICES[@]} )); then
    echo "🚫 Invalid selection."
    exit 1
  fi

  choice="${DEVICES[$((sel-1))]}"
  chosen_mac="${choice%% *}"
  chosen_name="${choice#* }"
  echo "✅ Selected: $chosen_name ($chosen_mac)"
  echo "$chosen_mac" >| "$CONFIG_FILE"
}

install_launch_agent() {
  echo "⚙️  Installing LaunchAgent…"

  mkdir -p "$(dirname "$PLIST_PATH")"
  cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
   "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
    <string>${LAUNCH_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${BASH_SOURCE[0]}</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
    <integer>600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
    <string>/tmp/autobluetooth.out</string>
  <key>StandardErrorPath</key>
    <string>/tmp/autobluetooth.err</string>
</dict>
</plist>
EOF

  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl load   "$PLIST_PATH"
  echo "🚀 Auto-connect scheduled every 10 minutes."
}

uninstall_launch_agent() {
  echo "🛑 Disabling auto-connect…"
  if [[ -f "$PLIST_PATH" ]]; then
    launchctl unload "$PLIST_PATH"
    rm -f "$PLIST_PATH"
    echo "🗑  LaunchAgent removed."
  else
    echo "ℹ️  No LaunchAgent found."
  fi
  rm -f "$CONFIG_FILE"
}

run_connect() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "⚠️  No device set. Run with ‘start’ first."
    exit 1
  fi
  mac="$(<"$CONFIG_FILE")"
  status="$("$BLUEUTIL" --is-connected "$mac")"
  if [[ "$status" -eq 0 ]]; then
    echo "🔗 Connecting to $mac…"
    "$BLUEUTIL" --connect "$mac"
  else
    echo "✅ Already connected to $mac."
  fi
}

# ————————————————
# Main
# ————————————————
case "$1" in
  start)
    list_and_choose
    install_launch_agent
    ;;
  stop)
    uninstall_launch_agent
    ;;
  status)
    launchctl list | grep -q "$LAUNCH_LABEL" \
      && echo "✅ Auto-connect is running." \
      || echo "⚠️  Auto-connect is not running."
    ;;
  run)
    run_connect
    ;;
  *)
    cat <<USAGE

Usage: $(basename "$0") {start|stop|status}

  start   → pick a device & kick off your 10-min auto-connect job  
  stop    → cancel the job & remove config  
  status  → see if it’s loaded  

USAGE
    exit 1
    ;;
esac
